# Pinned inputs for the Alpine build environment.
# Plain KEY=VALUE, sourced by bash. Change a pin only together with its verification (see README.md).

# --- Alpine release: official minirootfs, verified by sha256 and GPG signature ---
ALPINE_VERSION=3.24.2
ALPINE_BRANCH=v3.24
ALPINE_ARCH=x86_64
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
ROOTFS_FILE=alpine-minirootfs-${ALPINE_VERSION}-${ALPINE_ARCH}.tar.gz
ROOTFS_BASE_URL=${ALPINE_MIRROR}/${ALPINE_BRANCH}/releases/${ALPINE_ARCH}
# As published by Alpine; latest-releases.yaml and the .sha256 file agree.
ROOTFS_SHA256=c5ca053cfe1d85c5b96dff8b9bc57045f7f184a30ffb6b65776409ca90388677
# Signer of the release tarball (Natanael Copa). The public key is committed as ncopa.asc.
ROOTFS_SIGNER_FPR=0482D84022F52DF1C4E7CD43293ACD0907D9495A

# --- Vendored aports: read-only input, never modified by the build ---
APORTS_DIR=vendor/alpine-aports
APORTS_COMMIT=d9d560d5de74ff9a7a73f3c903d6f126a0bf3142
APORTS_TREE=475841678d601c7c30d0d93e406463547e6e3dd0

# --- Build parameters ---
# Fixed timestamp for reproducible output: committer time of the aports v3.24.2 commit.
SOURCE_DATE_EPOCH=1789666254
BUILD_JOBS=4
PACKAGER="Agent-Interaction Build <build@agent-interaction.invalid>"
BUILDER_USER=builder
BUILDER_UID=1000
BUILDER_GID=1000
# Top-level toolchain packages. Exact versions of everything installed are recorded in toolchain.lock.
TOOLCHAIN_PKGS="alpine-sdk su-exec"
