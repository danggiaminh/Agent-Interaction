# Kernel options the locked kernel must have for the test bed (make-guest.sh checks them against the kernel's
# own config).  option  y|m
# y = built in (cgroup v2 controllers, namespaces and the tracing and BPF facilities the tests probe cannot be modules);
# m = loadable module (resolved by modules.dep).
CGROUPS y
CGROUP_SCHED y
FAIR_GROUP_SCHED y
CFS_BANDWIDTH y
CPUSETS y
MEMCG y
BLK_CGROUP y
BLK_DEV_THROTTLING y
CGROUP_PIDS y
CGROUP_FREEZER y
CGROUP_HUGETLB y
CGROUP_DEVICE y
CGROUP_BPF y
PSI y
SCHEDSTATS y
NAMESPACES y
USER_NS y
PID_NS y
NET_NS y
UTS_NS y
IPC_NS y
FUNCTION_TRACER y
BPF_SYSCALL y
KALLSYMS y
BLK_DEV_INITRD y
DEVTMPFS y
SERIAL_8250_CONSOLE y
VIRTIO_PCI m
NET_9P_VIRTIO m
9P_FS m
VIRTIO_BLK m
VETH m
DUMMY m
NET_SCH_NETEM m
NF_TABLES m
BRIDGE m
BLK_DEV_LOOP m
EXT4_FS m
XFS_FS m
BTRFS_FS m
VFAT_FS m
NLS_CODEPAGE_437 m
MSDOS_PARTITION y
EFI_PARTITION y
CRYPTO_CRC32C m
NLS_UTF8 m
