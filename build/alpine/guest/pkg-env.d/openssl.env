# Sourced by build-pkg.sh before building main/openssl.
# bio_dgram_test also exercises AF_INET6 datagram sockets; the kernel this environment runs on has no
# IPv6 at all (no /proc/net/if_inet6), so socket(AF_INET6) fails with EAFNOSUPPORT and the test cannot
# pass here regardless of the source. Only that test is excluded; its IPv4 iterations pass when run
# by hand and every other test runs. Drop this file once the build host has IPv6.
export TESTS='-test_bio_dgram'
