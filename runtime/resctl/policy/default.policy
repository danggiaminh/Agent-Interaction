# Default resource policy for Agent-Interaction workloads (see ../README.md for the grammar).
#
# Domains:    agent-interaction/system     critical services: never killed, frozen or stopped by resctl
#             agent-interaction/workload   every AI workload together: the ceiling that keeps them off the system's memory
#             agent-interaction/workload/<class>/<id>   one workload: its own limits and its own kill domain
# Percentages are of the MemTotal of the machine, bound when the policy is loaded.

[system]
cpu.weight = 1000
memory.reserve = 128M
# A registered critical process gets this oom_score_adj (it needs CAP_SYS_RESOURCE): when the whole machine runs out of
# memory and no workload is left to take (workloads carry 1000), the OOM killer takes a critical process only once it is
# larger than an ordinary one by half of the memory. Never -1000: a critical service that leaks would leave the machine
# without memory and with nothing the kernel may take.
oom.score_adj = -500

[workload]
memory.max = 75%
pids.max = 4096

# interactive: an agent a person is waiting for
[class.interactive]
cpu.weight = 800
memory.max = 50%
pids.max = 2048

[limits.interactive]
memory.max = 25%
pids.max = 256

# batch: background and bulk work; yields the CPU to everything else
[class.batch]
cpu.weight = 100
memory.max = 50%
pids.max = 2048

[limits.batch]
memory.max = 25%
pids.max = 128

[stop]
grace = 5s

[recover]
orphans = kill

# Restart policy of a supervised workload (`resctl supervise`). Every count is bounded, and the caps are fixed in resctl:
# a policy that asks for more is refused, not clamped.
#   max      automatic restarts within one `window`        (at most 10)
#   total    automatic restarts during one supervisor run  (at most 100)
#   backoff  the wait before the first restart; it doubles with each further restart of a window, up to backoff.max
#   rate     starts per minute, all workloads together: a restart waits for room, a manual start is refused (at most 120)
# A workload that uses up its budget is `failed` and stays that way until an operator runs `resctl reset`.
[restart]
mode = on-failure
max = 3
window = 60s
total = 10
backoff = 500ms
backoff.max = 30s
rate = 30

# How many workloads one machine supervises at once (at most 64).
[supervise]
workloads = 16

# A workload never runs with the privileges of resctl: it is switched to this user and group before it executes. A
# supervisor that is root and has no uid and gid here refuses to start anything; allow.root = yes (and uid 0) is for a
# workload that is trusted as much as the system.
[run]
uid = 65534
gid = 65534
